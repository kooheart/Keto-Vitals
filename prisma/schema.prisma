generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money is stored as integer paise (₹1 = 100 paise). Never floats.

// ───────────────────────── Auth / RBAC ─────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // customer | manager | admin
  description String?
  /// Permission strings, e.g. "products.write", "orders.manage", "*"
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lower-case
  name            String
  phone           String?
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  tokens      AuthToken[]
  addresses   Address[]
  cart        Cart?
  wishlist    Wishlist?
  orders      Order[]
  reviews     Review[]
  redemptions CouponRedemption[]

  @@index([roleId])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ───────────────────────── Catalogue ─────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  imageUrl    String?
  isFeatured  Boolean             @default(false)
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  products    CollectionProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  brand            String        @default("Keto Vitals")
  shortDescription String?
  description      String
  features         String[]
  /// Free-form key/value specifications shown on the product page.
  specs            Json          @default("{}")
  /// Filterable attributes, e.g. "vegan", "sugar-free".
  tags             String[]
  /// Product form for filtering: Capsules, Powder, Tea, Gummies, Snack, Accessory…
  form             String?
  status           ProductStatus @default(DRAFT)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  /// GST rate (percent) applied to this product; prices are tax-inclusive.
  gstRate          Int           @default(18)
  hsnCode          String?

  // Denormalised, maintained by syncProductDerived() — used for sort/filter at DB level.
  minPricePaise    Int           @default(0)
  maxDiscountPct   Int           @default(0)
  inStock          Boolean       @default(false)
  ratingAvg        Float         @default(0)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)

  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  collections CollectionProduct[]
  wishlistedBy WishlistItem[]
  orderItems  OrderItem[]

  @@index([status, categoryId])
  @@index([status, minPricePaise])
  @@index([status, createdAt])
  @@index([status, soldCount])
  @@index([status, ratingAvg])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique
  name        String // e.g. "60 capsules" / "Lemon · 250 g"
  /// Selector attributes, e.g. {"size":"60 capsules","flavour":"Lemon"}
  attributes  Json     @default("{}")
  mrpPaise    Int // strike-through price
  pricePaise  Int // selling price (tax-inclusive)
  weightGrams Int      @default(250)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Units available to sell. Decremented atomically when an order is placed.
  quantity          Int            @default(0)
  lowStockThreshold Int            @default(10)
  updatedAt         DateTime       @updatedAt

  @@index([quantity])
}

// ───────────────────────── Cart / Wishlist ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Guest carts are keyed by an httpOnly cookie token (hash stored).
  guestHash  String?    @unique
  couponCode String?
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  wishlistId String
  productId  String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([wishlistId, productId])
  @@index([productId])
}

// ───────────────────────── Orders / Payments ─────────────────────────

enum OrderStatus {
  PENDING_PAYMENT // online payment not yet confirmed; stock is held
  PLACED // confirmed (paid, or COD)
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  COD_PENDING
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique // KV-YYMMDD-XXXXXX
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  phone           String
  status          OrderStatus
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus
  /// Client-supplied key; unique so a double-submit cannot create two orders.
  idempotencyKey  String        @unique
  /// Snapshot of the shipping address at time of order.
  shippingAddress Json

  subtotalPaise   Int // sum of line totals (tax-inclusive)
  discountPaise   Int           @default(0)
  shippingPaise   Int           @default(0)
  codFeePaise     Int           @default(0)
  taxPaise        Int           @default(0) // GST contained in the total (informational)
  totalPaise      Int
  couponCode      String?
  currency        String        @default("INR")

  carrier         String?
  trackingNumber  String?
  customerNote    String?
  cancelReason    String?
  stockReleasedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items       OrderItem[]
  payments    Payment[]
  events      OrderEvent[]
  redemptions CouponRedemption[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Historical snapshot — later price/name edits must not alter past orders.
  name          String
  variantName   String
  sku           String
  imageUrl      String?
  unitPricePaise Int
  mrpPaise      Int
  quantity      Int
  lineTotalPaise Int
  gstRate       Int

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String // razorpay | cod
  status             PaymentStatus @default(CREATED)
  amountPaise        Int
  currency           String        @default("INR")
  providerOrderId    String?       @unique
  /// Unique so the same Razorpay payment can never be applied twice.
  providerPaymentId  String?       @unique
  failureReason      String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orderId])
}

/// Processed webhook event ids — dedupes Razorpay retries.
model WebhookEvent {
  id         String   @id // provider event id
  provider   String
  type       String
  receivedAt DateTime @default(now())
}

// ───────────────────────── Marketing ─────────────────────────

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique // upper-case
  description      String?
  type             CouponType
  /// PERCENT: 1-100. FIXED: paise. FREE_SHIPPING: ignored.
  value            Int                @default(0)
  minSubtotalPaise Int                @default(0)
  maxDiscountPaise Int?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perUserLimit     Int?
  usedCount        Int                @default(0)
  isActive         Boolean            @default(true)
  redemptions      CouponRedemption[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  createdAt DateTime @default(now())

  @@index([couponId, email])
  @@index([couponId, userId])
}

enum BannerPlacement {
  HERO
  MID
  PROMO_STRIP
}

/// Homepage banners and promotional offers (managed from admin).
model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  eyebrow   String?
  title     String
  subtitle  String?
  ctaLabel  String?
  linkUrl   String?
  imageUrl  String?
  theme     String          @default("dark") // dark | light | gold
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int // 1..5
  title            String?
  body             String
  /// True only if the user has a DELIVERED order containing this product (set server-side).
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ───────────────────────── Shipping / Settings ─────────────────────────

model ShippingZone {
  id               String   @id @default(cuid())
  name             String
  /// PIN code prefixes (1-6 digits) this zone serves. Longest prefix wins.
  pinPrefixes      String[]
  ratePaise        Int      @default(0)
  etaMinDays       Int      @default(3)
  etaMaxDays       Int      @default(7)
  codAvailable     Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Key/value store for admin-editable configuration (see src/lib/settings.ts for keys).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
