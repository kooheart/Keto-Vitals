# ---- Core ----
DATABASE_URL="postgresql://keto:<DB_PASSWORD>@localhost:5432/keto_vitals?schema=public"
APP_URL="http://localhost:3000"
# Long random string (openssl rand -hex 32). Used to HMAC cron/utility tokens.
APP_SECRET="<RANDOM_HEX_64>"

# ---- Seed (only used by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="<CHOOSE_A_STRONG_PASSWORD>"

# ---- Razorpay (use TEST keys: https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID="<rzp_test_KEY_ID>"
RAZORPAY_KEY_SECRET="<RAZORPAY_KEY_SECRET>"
RAZORPAY_WEBHOOK_SECRET="<RAZORPAY_WEBHOOK_SECRET>"

# ---- Email (SMTP). If unset, emails are logged to the server console and NOT sent ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Keto Vitals <no-reply@example.com>"

# ---- Image storage: "local" (default, public/uploads) or "cloudinary" ----
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Protects POST /api/cron/release-stock (Authorization: Bearer <CRON_SECRET>) ----
CRON_SECRET="<RANDOM_HEX_32>"
TEST_DATABASE_URL="postgresql://keto:<DB_PASSWORD>@localhost:5432/keto_vitals_test?schema=public"
